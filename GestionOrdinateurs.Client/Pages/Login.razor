@page "/login"

@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject NavigationManager Navigation
@inject JwtAuthenticationStateProvider AuthProvider
@inject IAuthentificationService AuthService


<h3>Login</h3>
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger mt-2">@ErrorMessage</div>
}

<InputText @bind-Value="Token" class="form-control" />

<button class="btn btn-primary mt-2" @onclick="SaveToken">
    Se connecter
</button>

@code
{
    private string Token = "";
    private string? ErrorMessage;

    private async Task SaveToken()
    {
        var user = await AuthService.LogAsync(Token);
         if (!string.IsNullOrEmpty(user))
        {
            await SessionStorage.SetItemAsync("jwtToken", user);
            AuthProvider.NotifyUserAuthentication(user);
            Navigation.NavigateTo("/");
        }
        else
        {
            ErrorMessage = "Authentification non trouvée !";
        }

    }
}